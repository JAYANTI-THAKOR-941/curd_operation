<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Products</title>
    <style>
        table{
            width: 80%;
            margin: 4% auto;
        }
        table,tr,td,th{
            border: 1px solid black;
            border-collapse: collapse;
            text-align: center;
            padding: 15px;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th colspan="2">Action</th>
        </tr>
        <% products.forEach((product)=>{ %>
            <tr>
                <td><%= product.id %></td>
                <td><%= product.name %></td>
                <td><%= product.category %></td>
                <td><%= product.price %></td>
                <td><a href="#">Edit</a></td>
                <td><a href="#">Delete</a></td>
            </tr>
        <% });%>
    </table>
</body>
</html>